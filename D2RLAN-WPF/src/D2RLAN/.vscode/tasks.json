{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🚀 Build, Deploy & Run D2RLAN",
            "type": "shell",
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy", "Bypass",
                    "-File", "${workspaceFolder}\\..\\..\\..\\..\\..\\D2GitSync\\.vscode\\build.ps1"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": { "kind": "build", "isDefault": true },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": "$msCompile",
            "runOptions": { "reevaluateOnRerun": true }
        }
    ]
}