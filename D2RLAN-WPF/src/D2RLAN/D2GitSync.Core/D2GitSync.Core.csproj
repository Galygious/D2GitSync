<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>D2GitSync.Core</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>D2R Community</Authors>
    <Description>Core library for D2R save file synchronization using Git and symlinks</Description>
    <PackageTags>diablo2;d2r;saves;git;sync</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="7.0.1" />
    <PackageReference Include="System.Text.Json" Version="7.0.3" />
  </ItemGroup>

</Project>
